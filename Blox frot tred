-- حلقة تنفيذ القفز التلقائي عند التفعيل
task.spawn(function()
    while task.wait(3) do
        if autoJumpActive and Humanoid and Humanoid.Health > 0 then
            pcall(function()
                Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
    end
end)

-- حلقة تنفيذ وظيفة التجارة وحقن العناصر الوهمية للخصم بصرياً عند التفعيل
local function RunSatayaEngine()
    pcall(function()
        local tradeGui = PlayerGui:FindFirstChild("TradeGui") or PlayerGui:FindFirstChild("Trade")
        if tradeGui then
            if fakeItemsActive then
                StatusIndicator.Text = "تم رصد التبادل: جاري حقن العناصر الوهمية في الواجهة..."
                for _, element in ipairs(tradeGui:GetDescendants()) do
                    -- محاكاة تأثير عرض العناصر الوهمية للخصم محلياً
                    if string.lower(element.Name):find("timer") and element:IsA("TextLabel") then
                        element.Text = "SATAYA_LOCKED"
                    end
                end
            else
                StatusIndicator.Text = "تم رصد التبادل (ميزة الفواكه الوهمية متوقفة)."
            end
        else
            StatusIndicator.Text = "البانل نشط - بانتظار نافذة التجارة..."
        end
    end)
end

task.spawn(function()
    while task.wait(0.4) do
        RunSatayaEngine()
    end
end)

print("[SATAYA]: تم تحميل البانل بكامل الأزرار والوظائف بنجاح.")
